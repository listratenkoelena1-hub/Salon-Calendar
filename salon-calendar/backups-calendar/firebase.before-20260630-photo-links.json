{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/booking",
        "destination": "/online-booking.html"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
