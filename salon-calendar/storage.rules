rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isCalendarTeam() {
      return request.auth != null
        && firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['manager', 'staff'];
    }

    match /messenger-media/{date}/{fileName} {
      allow read: if isCalendarTeam();
      allow create: if isCalendarTeam()
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp)|audio/(mp4|webm)');
      allow delete: if isCalendarTeam()
        && resource.metadata.senderUid == request.auth.uid;
      allow update: if false;
    }

    match /messenger-pinned-media/{date}/{fileName} {
      allow read: if isCalendarTeam();
      allow create: if isCalendarTeam()
        && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|webp)|audio/(mp4|webm)');
      allow update, delete: if false;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
