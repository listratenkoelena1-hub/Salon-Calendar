{
    "firestore": {
        "rules": "firestore.rules",
        "indexes": "firestore.indexes.json"
    },
    "storage": {
        "rules": "storage.rules"
    },
    "hosting":  [
                    {
                        "target":  "calendar",
                        "public":  ".",
                        "ignore":  [
                                       "firebase.json",
                                       "firebase.pre-migration.json",
                                       "firestore.rules",
                                       "firestore.pre-migration.rules",
                                       "firestore.indexes.json",
                                       "storage.rules",
                                       "**/*.test.mjs",
                                       "booking-public/**",
                                       "**/.*",
                                       "**/node_modules/**",
                                       "backups-calendar/**",
                                       "backups-online-booking/**",
                                       "design-mockups/**"
                                   ],
                        "headers":  [
                                        {
                                            "source":  "**",
                                            "headers":  [
                                                            {
                                                                "key":  "X-Robots-Tag",
                                                                "value":  "noindex, nofollow"
                                                            }
                                                        ]
                                        }
                                    ],
                        "rewrites":  [
                                         {
                                             "source":  "/booking",
                                             "destination":  "/online-booking.html"
                                         },
                                         {
                                             "source":  "/booking-photo",
                                             "destination":  "/booking-photo.html"
                                         },
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ]
                    },
                    {
                        "target":  "booking",
                        "public":  "booking-public",
                        "ignore":  [
                                       "firebase.json",
                                       "firestore.rules",
                                       "firestore.indexes.json",
                                       "storage.rules",
                                       "**/*.test.mjs",
                                       "**/.*",
                                       "**/node_modules/**",
                                       "backups-calendar/**",
                                       "backups-online-booking/**",
                                       "design-mockups/**"
                                   ],
                        "headers":  [
                                        {
                                            "source":  "/booking-photo.html",
                                            "headers":  [
                                                            {
                                                                "key":  "X-Robots-Tag",
                                                                "value":  "noindex, nofollow"
                                                            }
                                                        ]
                                        }
                                    ],
                        "rewrites":  [
                                         {
                                             "source":  "/booking",
                                             "destination":  "/index.html"
                                         },
                                         {
                                             "source":  "/online-booking.html",
                                             "destination":  "/index.html"
                                         },
                                         {
                                             "source":  "/booking-photo",
                                             "destination":  "/booking-photo.html"
                                         },
                                         {
                                             "source":  "**",
                                             "destination":  "/index.html"
                                         }
                                     ]
                    }
                ]
}
