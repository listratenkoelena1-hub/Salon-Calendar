rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && currentUser().role == role;
    }

    // Compatibility phase: production keeps reading raw appointments until
    // every existing record has a contact-free appointmentPublic projection.
    match /appointments/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    // Existing production collision locks. Never expose or repurpose them.
    match /appointmentSchedules/{document=**} {
      allow read, write: if false;
    }

    // Contact-free projection populated by server functions during migration.
    match /appointmentPublic/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /activityLogPublic/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole('manager'));
      allow write: if false;
    }

    match /staff/{staffId} {
      allow read: if signedIn();
      allow create, delete: if hasRole('manager');
      allow update: if hasRole('manager')
        || (hasRole('staff')
          && currentUser().staffId == staffId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['color', 'bookingDurations']));
    }

    // These collections are server-only before the first private record is
    // written. Admin SDK functions bypass Firestore Security Rules.
    match /clientLookup/{document=**} {
      allow read, write: if false;
    }

    match /clientProfiles/{document=**} {
      allow read, write: if false;
    }

    match /clientPhoneIndex/{document=**} {
      allow read, write: if false;
    }

    match /appointmentPrivate/{document=**} {
      allow read, write: if false;
    }

    match /activityLogPrivate/{document=**} {
      allow read, write: if false;
    }

    match /clientLookupAudit/{document=**} {
      allow read, write: if false;
    }

    match /clientLookupRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingEmailContacts/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingPrivateData/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingVerificationData/{document=**} {
      allow read, write: if false;
    }

    // Preserve all other currently authenticated browser operations during
    // migration. Explicit exclusions prevent this wildcard from reopening a
    // protected collection because Firestore allows access if any match does.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'appointments'
        && collection != 'appointmentSchedules'
        && collection != 'appointmentPublic'
        && collection != 'activityLogPublic'
        && collection != 'users'
        && collection != 'staff'
        && collection != 'clientLookup'
        && collection != 'clientProfiles'
        && collection != 'clientPhoneIndex'
        && collection != 'appointmentPrivate'
        && collection != 'activityLogPrivate'
        && collection != 'clientLookupAudit'
        && collection != 'clientLookupRateLimits'
        && collection != 'onlineBookingEmailContacts'
        && collection != 'onlineBookingPrivateData'
        && collection != 'onlineBookingVerificationData';
    }
  }
}
