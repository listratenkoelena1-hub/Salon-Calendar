{
  "name": "functions",
  "description": "Cloud Functions for Firebase",
  "scripts": {
    "test": "node --test appointment-schedule.test.js appointment-access.test.js booking-management.test.js push-notification.test.js booking-duration.test.js client-history-core.test.js client-history-store.test.js client-history-backfill-core.test.js client-history-backfill-cli.test.js firestore-rules-contract.test.js",
    "test:emulator": "node --test --test-concurrency=1 firestore-rules-emulator.test.js client-history-backfill-emulator.test.js",
    "test:integration": "node --test booking-client-integration-emulator.test.js",
    "test:main-rules-compat": "node --test current-main-rules-compat-emulator.test.js",
    "test:safe-rollback": "node --test safe-rollback-rules-emulator.test.js",
    "serve": "firebase emulators:start --only functions",
    "shell": "firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "logs": "firebase functions:log"
  },
  "engines": {
    "node": "22"
  },
  "main": "index.js",
  "dependencies": {
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "nodemailer": "^9.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "firebase": "^12.19.0",
    "firebase-functions-test": "^3.5.0"
  },
  "overrides": {
    "fast-xml-parser": "5.10.1",
    "websocket-driver": "0.7.5"
  },
  "private": true
}
