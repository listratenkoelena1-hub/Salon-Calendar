rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasRole(role) {
      return signedIn() && currentUser().role == role;
    }

    // Preserve the currently deployed appointment contract: browsers read,
    // while every appointment write continues through mutateAppointment.
    match /appointments/{document=**} {
      allow read: if signedIn();
      allow create, update, delete: if false;
    }

    match /appointmentSchedules/{document=**} {
      allow read, write: if false;
    }

    // These collections must remain closed even if frontend and Functions are
    // rolled back after client-history data has already been created.
    match /appointmentPrivate/{document=**} {
      allow read, write: if false;
    }

    match /clientLookup/{document=**} {
      allow read, write: if false;
    }

    match /clientProfiles/{document=**} {
      allow read, write: if false;
    }

    match /clientPhoneIndex/{document=**} {
      allow read, write: if false;
    }

    match /clientAppointmentHistory/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingVerificationChallenges/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingVerificationRateLimits/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingEmailContacts/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingSubmissions/{document=**} {
      allow read, write: if false;
    }

    match /onlineBookingPhotos/{document=**} {
      allow read, write: if false;
    }

    match /EmailQueue/{document=**} {
      allow read, write: if false;
    }

    match /SmsQueue/{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if signedIn() && (request.auth.uid == userId || hasRole('manager'));
      allow write: if false;
    }

    match /staff/{staffId} {
      allow read: if signedIn();
      allow create, delete: if hasRole('manager');
      allow update: if hasRole('manager')
        || (
          hasRole('staff')
          && currentUser().staffId == staffId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['color', 'bookingDurations'])
        );
    }

    // Match current main for all existing operational collections, including
    // activityLog, while excluding every private/internal collection above.
    match /{collection}/{document=**} {
      allow read, write: if signedIn()
        && collection != 'appointments'
        && collection != 'appointmentSchedules'
        && collection != 'appointmentPrivate'
        && collection != 'clientLookup'
        && collection != 'clientProfiles'
        && collection != 'clientPhoneIndex'
        && collection != 'clientAppointmentHistory'
        && collection != 'onlineBookingVerificationChallenges'
        && collection != 'onlineBookingVerificationRateLimits'
        && collection != 'onlineBookingEmailContacts'
        && collection != 'onlineBookingSubmissions'
        && collection != 'onlineBookingPhotos'
        && collection != 'EmailQueue'
        && collection != 'SmsQueue'
        && collection != 'users'
        && collection != 'staff';
    }
  }
}
